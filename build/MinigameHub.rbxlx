          <string name="Name">GameConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Global tuning values for the hub loop. Extend as tycoon / pets / rebirth systems land.
]]

local GameConfig = {
	DataStore = {
		ProfileKeyPrefix = "Player_",
		StoreName = "HybridCasualHub_v1",
	},

	Minigame = {
		LobbyCountdownSeconds = 3,
		DurationSeconds = 30,
		DefaultCoinReward = 50,
	},

	World = {
		LobbySpawnName = "LobbySpawn",
		ArenaSpawnName = "ArenaSpawn",
		HubModelName = "Hub",
	},

	BossCombat = {
		DefaultBossMaxHP = 5000,
		CoinsPerDamage = 2,
		FinishLineTag = "MultiplierRunnerFinish",
		BossModelName = "SwarmBoss",
		BossHitboxName = "Hitbox",
		RunnerArmyAttribute = "RunnerArmySize",
	},

	SwarmVisuals = {
		MaxAnimatedSoldiers = 180,
		SoldiersPerFrame = 10,
		TweenDurationSeconds = 0.35,
		HitStaggerSeconds = 0.02,
	},
}

return GameConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Remotes</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Remote names live in one place so server and client stay in sync.
	Instances are created at runtime by RemotesService (server).
]]

local Remotes = {
	FolderName = "Remotes",
	PlayerDataUpdated = "PlayerDataUpdated",
	MinigameStateChanged = "MinigameStateChanged",
	PlaySwarmAnimation = "PlaySwarmAnimation",
	TycoonRequestPurchase = "TycoonRequestPurchase",
	TycoonProgressUpdated = "TycoonProgressUpdated",
	TycoonStructureSpawned = "TycoonStructureSpawned",
}

return Remotes
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">TycoonConfig</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Tycoon node definitions (single source of truth for costs, deps, buffs).

	How to expand:
	1. Add a Model under ReplicatedStorage.TycoonPrefabs matching `PrefabName`.
	2. Append a new entry to `Nodes` with a unique `ID`.
	3. Set `Dependency` to the prerequisite node ID (or nil for roots).
	4. Tune `PlotOffset` (CFrame relative to the player's plot origin).
	5. Optional `Buff` permanently increases `Stats[Stat]` on the server profile.
]]

export type TycoonBuff = {
	Stat: string,
	Value: number,
}

export type TycoonNode = {
	ID: string,
	Cost: number,
	PrefabName: string,
	Dependency: string?,
	PlotOffset: CFrame,
	Buff: TycoonBuff?,
}

local TycoonConfig = {
	--[[
		Expand by copying a block and chaining Dependency:
		Dependency = "PreviousNodeId"
	]]
	Nodes = {
		Barracks = {
			ID = "Barracks",
			Cost = 150,
			PrefabName = "Barracks",
			Dependency = nil,
			PlotOffset = CFrame.new(-12, 0, -10),
			Buff = { Stat = "StartingArmy", Value = 5 },
		},
		Armory = {
			ID = "Armory",
			Cost = 400,
			PrefabName = "Armory",
			Dependency = "Barracks",
			PlotOffset = CFrame.new(0, 0, -14),
			Buff = { Stat = "StartingArmy", Value = 10 },
		},
		CommandCenter = {
			ID = "CommandCenter",
			Cost = 900,
			PrefabName = "CommandCenter",
			Dependency = "Armory",
			PlotOffset = CFrame.new(12, 0, -10),
			Buff = { Stat = "StartingArmy", Value = 20 },
		},
	} :: { [string]: TycoonNode },
}

local nodeList: { TycoonNode }? = nil

function TycoonConfig.getNode(nodeId: string): TycoonNode?
	return TycoonConfig.Nodes[nodeId]
end

function TycoonConfig.getAllNodes(): { TycoonNode }
	if nodeList then
		return nodeList
	end
	local list: { TycoonNode } = {}
	for _, node in TycoonConfig.Nodes do
		table.insert(list, node)
	end
	table.sort(list, function(a, b)
		return a.Cost < b.Cost
	end)
	nodeList = list
	return list
end

--[[
	Shared predicate for UI hints only — server MUST re-validate before spending currency.
]]
function TycoonConfig.canPurchase(
	nodeId: string,
	unlocked: { [string]: boolean },
	coins: number
): (boolean, string?)
	local node = TycoonConfig.getNode(nodeId)
	if not node then
		return false, "InvalidNode"
	end
	if unlocked[nodeId] then
		return false, "AlreadyUnlocked"
	end
	if node.Dependency and not unlocked[node.Dependency] then
		return false, "MissingDependency"
	end
	if coins < node.Cost then
		return false, "InsufficientCoins"
	end
	return true, nil
end

return TycoonConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Types</string>
          <string name="Source"><![CDATA[--!strict
--[[
	Shared Luau types for the hybrid-casual minigame hub.
]]

export type PlayerStats = {
	StartingArmy: number,
}

export type PlayerData = {
	Coins: number,
	Gems: number,
	Rebirths: number,
	TycoonUnlocked: { [string]: boolean },
	Stats: PlayerStats,
}

export type MinigamePhase = "Lobby" | "Playing" | "Reward" | "Idle"

export type MinigameStatePayload = {
	phase: MinigamePhase,
	timeRemaining: number,
}

export type PlayerDataPayload = PlayerData

export type TycoonProgressPayload = {
	unlocked: { [string]: boolean },
	coins: number,
	stats: PlayerStats,
}

export type TycoonStructureSpawnedPayload = {
	ownerUserId: number,
	nodeId: string,
	plotName: string,
}

export type SwarmAttackPayload = {
	armySize: number,
	damageDealt: number,
	survivingSoldiers: number,
	bossMaxHP: number,
	bossCurrentHP: number,
	coinsAwarded: number,
}

return nil
]]></string>
        </Properties>
