      <Item class="Folder" referent="18">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local TycoonConfig = require(ReplicatedStorage.Shared.TycoonConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type RemotesService = require(script.Parent.RemotesService)
type PlayerData = Types.PlayerData
type PlayerStats = Types.PlayerStats

local ProfileService = require(ServerStorage.ServerPackages.ProfileService)

export type DataService = {
	Init: (self: DataService, remotesService: RemotesService) -> (),
	GetData: (self: DataService, player: Player) -> PlayerData?,
	AddCoins: (self: DataService, player: Player, amount: number) -> boolean,
	TrySpendCoins: (self: DataService, player: Player, amount: number) -> boolean,
	IsTycoonUnlocked: (self: DataService, player: Player, nodeId: string) -> boolean,
	UnlockTycoonNode: (self: DataService, player: Player, nodeId: string) -> boolean,
	GetStats: (self: DataService, player: Player) -> PlayerStats,
	OnProfileReady: (self: DataService, player: Player, callback: (data: PlayerData) -> ()) -> (),
	PushDataToClient: (self: DataService, player: Player, remotesService: RemotesService) -> (),
}

local DataService = {} :: DataService
DataService.__index = DataService

type Profile = any

local DEFAULT_STATS: PlayerStats = {
	StartingArmy = 0,
}

local profileTemplate = {
	Coins = 0,
	Gems = 0,
	Rebirths = 0,
	TycoonUnlocked = {},
	Stats = {
		StartingArmy = 0,
	},
}

local profileStore = ProfileService.GetProfileStore(GameConfig.DataStore.StoreName, profileTemplate)

local profiles: { [Player]: Profile } = {}
local readyCallbacks: { [Player]: { (data: PlayerData) -> () } } = {}

local function normalizeUnlocked(raw: any): { [string]: boolean }
	local unlocked: { [string]: boolean } = {}
	if typeof(raw) == "table" then
		for key, value in raw do
			if value == true then
				unlocked[tostring(key)] = true
			end
		end
	end
	return unlocked
end

local function normalizeStats(raw: any): PlayerStats
	if typeof(raw) ~= "table" then
		return table.clone(DEFAULT_STATS)
	end
	return {
		StartingArmy = if typeof(raw.StartingArmy) == "number" then raw.StartingArmy else 0,
	}
end

local function snapshotFromProfile(profile: Profile): PlayerData
	local data = profile.Data
	return {
		Coins = data.Coins,
		Gems = data.Gems,
		Rebirths = data.Rebirths,
		TycoonUnlocked = normalizeUnlocked(data.TycoonUnlocked),
		Stats = normalizeStats(data.Stats),
	}
end

local function applyBuffToProfile(profile: Profile, buff: { Stat: string, Value: number })
	local stats = profile.Data.Stats
	if typeof(stats) ~= "table" then
		profile.Data.Stats = table.clone(DEFAULT_STATS)
		stats = profile.Data.Stats
	end
	if buff.Stat == "StartingArmy" then
		stats.StartingArmy = (stats.StartingArmy or 0) + buff.Value
	end
end

local function syncStatAttributes(player: Player, stats: PlayerStats)
	player:SetAttribute("Stat_StartingArmy", stats.StartingArmy)
end

function DataService:Init(remotesService: RemotesService)
	local playerDataRemote = remotesService:GetPlayerDataUpdated()

	local function onPlayerAdded(player: Player)
		local profileKey = GameConfig.DataStore.ProfileKeyPrefix .. player.UserId
		local profile = profileStore:LoadProfileAsync(profileKey)

		if profile == nil then
			player:Kick("Could not load data. Please rejoin.")
			return
		end

		profile:AddUserId(player.UserId)
		profile:Reconcile()

		profile:ListenToRelease(function()
			profiles[player] = nil
			if player.Parent then
				player:Kick("Profile released — please rejoin.")
			end
		end)

		if player.Parent ~= Players then
			profile:Release()
			return
		end

		profiles[player] = profile
		local snapshot = snapshotFromProfile(profile)
		syncStatAttributes(player, snapshot.Stats)
		playerDataRemote:FireClient(player, snapshot)

		local callbacks = readyCallbacks[player]
		if callbacks then
			for _, callback in callbacks do
				task.spawn(callback, snapshot)
			end
			readyCallbacks[player] = nil
		end
	end

	local function onPlayerRemoving(player: Player)
		local profile = profiles[player]
		profiles[player] = nil
		readyCallbacks[player] = nil
		if profile then
			profile:Release()
		end
	end

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end
end

function DataService:GetData(player: Player): PlayerData?
	local profile = profiles[player]
	if not profile then
		return nil
	end
	return snapshotFromProfile(profile)
end

function DataService:AddCoins(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount <= 0 then
		return false
	end

	profile.Data.Coins += amount
	return true
end

function DataService:TrySpendCoins(player: Player, amount: number): boolean
	local profile = profiles[player]
	if not profile or amount <= 0 then
		return false
	end
	if profile.Data.Coins < amount then
		return false
	end
	profile.Data.Coins -= amount
	return true
end

function DataService:IsTycoonUnlocked(player: Player, nodeId: string): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end
	local unlocked = normalizeUnlocked(profile.Data.TycoonUnlocked)
	return unlocked[nodeId] == true
end

function DataService:UnlockTycoonNode(player: Player, nodeId: string): boolean
	local profile = profiles[player]
	if not profile then
		return false
	end

	if typeof(profile.Data.TycoonUnlocked) ~= "table" then
		profile.Data.TycoonUnlocked = {}
	end

	local node = TycoonConfig.getNode(nodeId)
	if not node then
		return false
	end

	profile.Data.TycoonUnlocked[nodeId] = true
	if node.Buff then
		applyBuffToProfile(profile, node.Buff)
		syncStatAttributes(player, normalizeStats(profile.Data.Stats))
	end

	return true
end

function DataService:GetStats(player: Player): PlayerStats
	local data = self:GetData(player)
	if not data then
		return table.clone(DEFAULT_STATS)
	end
	return data.Stats
end

function DataService:OnProfileReady(player: Player, callback: (data: PlayerData) -> ())
	if profiles[player] then
		callback(snapshotFromProfile(profiles[player]))
		return
	end

	local list = readyCallbacks[player]
	if not list then
		list = {}
		readyCallbacks[player] = list
	end
	table.insert(list, callback)
end

function DataService:PushDataToClient(player: Player, remotesService: RemotesService)
	local data = self:GetData(player)
	if not data then
		return
	end
	remotesService:GetPlayerDataUpdated():FireClient(player, data)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">MinigameManager</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type DataService = require(script.Parent.DataService)
type RemotesService = require(script.Parent.RemotesService)
type MinigamePhase = Types.MinigamePhase

export type MinigameManager = {
	Init: (self: MinigameManager, dataService: DataService, remotesService: RemotesService) -> (),
}

local MinigameManager = {} :: MinigameManager
MinigameManager.__index = MinigameManager

type SessionState = {
	phase: MinigamePhase,
	taskToken: number,
}

local sessions: { [Player]: SessionState } = {}
local dataServiceRef: DataService? = nil
local remotesServiceRef: RemotesService? = nil
local nextSessionToken = 0

local function getHubSpawn(name: string): SpawnLocation?
	local hub = Workspace:FindFirstChild(GameConfig.World.HubModelName)
	if not hub then
		return nil
	end
	local spawn = hub:FindFirstChild(name)
	if spawn and spawn:IsA("SpawnLocation") then
		return spawn
	end
	return nil
end

local function teleportCharacterToSpawn(player: Player, spawnName: string)
	local character = player.Character
	if not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local spawn = getHubSpawn(spawnName)
	if root and spawn then
		root.CFrame = spawn.CFrame + Vector3.new(0, 3, 0)
	end
end

local function fireMinigameState(player: Player, phase: MinigamePhase, timeRemaining: number)
	local remotes = remotesServiceRef
	if not remotes then
		return
	end
	remotes:GetMinigameStateChanged():FireClient(player, {
		phase = phase,
		timeRemaining = timeRemaining,
	})
end

local function cancelSession(player: Player)
	local session = sessions[player]
	if session then
		session.taskToken = -1
	end
	sessions[player] = nil
end

local function runMinigameLoop(player: Player, token: number)
	local config = GameConfig.Minigame
	local dataService = dataServiceRef
	local remotes = remotesServiceRef
	if not dataService or not remotes then
		return
	end

	local session = sessions[player]
	if not session or session.taskToken ~= token then
		return
	end

	session.phase = "Lobby"
	for remaining = config.LobbyCountdownSeconds, 1, -1 do
		if not sessions[player] or sessions[player].taskToken ~= token then
			return
		end
		fireMinigameState(player, "Lobby", remaining)
		task.wait(1)
	end

	if not sessions[player] or sessions[player].taskToken ~= token then
		return
	end

	teleportCharacterToSpawn(player, GameConfig.World.ArenaSpawnName)
	session.phase = "Playing"

	for remaining = config.DurationSeconds, 0, -1 do
		if not sessions[player] or sessions[player].taskToken ~= token then
			return
		end
		fireMinigameState(player, "Playing", remaining)
		if remaining == 0 then
			break
		end
		task.wait(1)
	end

	if not sessions[player] or sessions[player].taskToken ~= token then
		return
	end

	dataService:AddCoins(player, config.DefaultCoinReward)
	dataService:PushDataToClient(player, remotes)

	session.phase = "Reward"
	fireMinigameState(player, "Reward", 0)
	task.wait(2)

	teleportCharacterToSpawn(player, GameConfig.World.LobbySpawnName)
	sessions[player] = nil
	fireMinigameState(player, "Idle", 0)

	task.defer(function()
		if player.Parent == Players then
			MinigameManager:StartSession(player)
		end
	end)
end

function MinigameManager:StartSession(player: Player)
	cancelSession(player)
	nextSessionToken += 1
	local token = nextSessionToken
	sessions[player] = {
		phase = "Idle",
		taskToken = token,
	}
	task.spawn(runMinigameLoop, player, token)
end

function MinigameManager:Init(dataService: DataService, remotesService: RemotesService)
	dataServiceRef = dataService
	remotesServiceRef = remotesService

	local function hookPlayer(player: Player)
		dataService:OnProfileReady(player, function()
			teleportCharacterToSpawn(player, GameConfig.World.LobbySpawnName)
			self:StartSession(player)
		end)

		player.CharacterAdded:Connect(function()
			if sessions[player] then
				local phase = sessions[player].phase
				if phase == "Playing" then
					teleportCharacterToSpawn(player, GameConfig.World.ArenaSpawnName)
				else
					teleportCharacterToSpawn(player, GameConfig.World.LobbySpawnName)
				end
			end
		end)
	end

	Players.PlayerAdded:Connect(hookPlayer)
	Players.PlayerRemoving:Connect(cancelSession)

	for _, player in Players:GetPlayers() do
		hookPlayer(player)
	end
end

return MinigameManager
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">RemotesService</string>
            <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage.Shared.Remotes)

export type RemotesService = {
	Init: (self: RemotesService) -> (),
	GetFolder: (self: RemotesService) -> Folder,
	GetPlayerDataUpdated: (self: RemotesService) -> RemoteEvent,
	GetMinigameStateChanged: (self: RemotesService) -> RemoteEvent,
	GetPlaySwarmAnimation: (self: RemotesService) -> RemoteEvent,
	GetTycoonRequestPurchase: (self: RemotesService) -> RemoteFunction,
	GetTycoonProgressUpdated: (self: RemotesService) -> RemoteEvent,
	GetTycoonStructureSpawned: (self: RemotesService) -> RemoteEvent,
}

local RemotesService = {} :: RemotesService
RemotesService.__index = RemotesService

local folder: Folder? = nil
local playerDataUpdated: RemoteEvent? = nil
local minigameStateChanged: RemoteEvent? = nil
local playSwarmAnimation: RemoteEvent? = nil
local tycoonRequestPurchase: RemoteFunction? = nil
local tycoonProgressUpdated: RemoteEvent? = nil
local tycoonStructureSpawned: RemoteEvent? = nil

local function getOrCreateRemoteEvent(parent: Instance, name: string): RemoteEvent
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = parent
	return remote
end

local function getOrCreateRemoteFunction(parent: Instance, name: string): RemoteFunction
	local existing = parent:FindFirstChild(name)
	if existing and existing:IsA("RemoteFunction") then
		return existing
	end

	local remote = Instance.new("RemoteFunction")
	remote.Name = name
	remote.Parent = parent
	return remote
end

function RemotesService:Init()
	local remotesFolder = ReplicatedStorage:FindFirstChild(Remotes.FolderName)
	if not remotesFolder or not remotesFolder:IsA("Folder") then
		remotesFolder = Instance.new("Folder")
		remotesFolder.Name = Remotes.FolderName
		remotesFolder.Parent = ReplicatedStorage
	end

	folder = remotesFolder
	playerDataUpdated = getOrCreateRemoteEvent(remotesFolder, Remotes.PlayerDataUpdated)
	minigameStateChanged = getOrCreateRemoteEvent(remotesFolder, Remotes.MinigameStateChanged)
	playSwarmAnimation = getOrCreateRemoteEvent(remotesFolder, Remotes.PlaySwarmAnimation)
	tycoonRequestPurchase = getOrCreateRemoteFunction(remotesFolder, Remotes.TycoonRequestPurchase)
	tycoonProgressUpdated = getOrCreateRemoteEvent(remotesFolder, Remotes.TycoonProgressUpdated)
	tycoonStructureSpawned = getOrCreateRemoteEvent(remotesFolder, Remotes.TycoonStructureSpawned)
end

function RemotesService:GetFolder(): Folder
	assert(folder, "RemotesService not initialized")
	return folder
end

function RemotesService:GetPlayerDataUpdated(): RemoteEvent
	assert(playerDataUpdated, "RemotesService not initialized")
	return playerDataUpdated
end

function RemotesService:GetMinigameStateChanged(): RemoteEvent
	assert(minigameStateChanged, "RemotesService not initialized")
	return minigameStateChanged
end

function RemotesService:GetPlaySwarmAnimation(): RemoteEvent
	assert(playSwarmAnimation, "RemotesService not initialized")
	return playSwarmAnimation
end

function RemotesService:GetTycoonRequestPurchase(): RemoteFunction
	assert(tycoonRequestPurchase, "RemotesService not initialized")
	return tycoonRequestPurchase
end

function RemotesService:GetTycoonProgressUpdated(): RemoteEvent
	assert(tycoonProgressUpdated, "RemotesService not initialized")
	return tycoonProgressUpdated
end

function RemotesService:GetTycoonStructureSpawned(): RemoteEvent
	assert(tycoonStructureSpawned, "RemotesService not initialized")
	return tycoonStructureSpawned
end

return RemotesService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Script" referent="22">
        <Properties>
          <string name="Name">TycoonService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
--[[
	Authoritative tycoon purchases — costs, dependencies, and currency live on the server.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Server = script.Parent
local DataService = require(Server.Services.DataService)
local RemotesService = require(Server.Services.RemotesService)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local TycoonConfig = require(ReplicatedStorage.Shared.TycoonConfig)
local Types = require(ReplicatedStorage.Shared.Types)

type TycoonProgressPayload = Types.TycoonProgressPayload
type TycoonStructureSpawnedPayload = Types.TycoonStructureSpawnedPayload

local PLOTS_FOLDER_NAME = "TycoonPlots"
local PLOT_ORIGIN_NAME = "Origin"
local STRUCTURES_FOLDER_NAME = "Structures"

local plotByPlayer: { [Player]: Model } = {}
local plotAssignments: { [string]: Player } = {}

local function waitForTycoonRemotes()
	local folder = ReplicatedStorage:WaitForChild(Remotes.FolderName)
	folder:WaitForChild(Remotes.TycoonRequestPurchase)
	folder:WaitForChild(Remotes.TycoonProgressUpdated)
	folder:WaitForChild(Remotes.TycoonStructureSpawned)
end

local function getPlotsFolder(): Folder?
	local hub = Workspace:FindFirstChild("Hub")
	if not hub then
		return nil
	end
	local plots = hub:FindFirstChild(PLOTS_FOLDER_NAME)
	if plots and plots:IsA("Folder") then
		return plots
	end
	return nil
end

local function getPrefabsFolder(): Folder?
	local prefabs = ReplicatedStorage:FindFirstChild("TycoonPrefabs")
	if prefabs and prefabs:IsA("Folder") then
		return prefabs
	end
	return nil
end

local function assignPlot(player: Player): Model?
	local existing = plotByPlayer[player]
	if existing then
		return existing
	end

	local plotsFolder = getPlotsFolder()
	if not plotsFolder then
		warn("[TycoonService] Missing Workspace.Hub.TycoonPlots")
		return nil
	end

	for _, plot in plotsFolder:GetChildren() do
		if plot:IsA("Model") and plotAssignments[plot.Name] == nil then
			plotAssignments[plot.Name] = player
			plotByPlayer[player] = plot
			plot:SetAttribute("OwnerUserId", player.UserId)

			local structures = plot:FindFirstChild(STRUCTURES_FOLDER_NAME)
			if not structures then
				structures = Instance.new("Folder")
				structures.Name = STRUCTURES_FOLDER_NAME
				structures.Parent = plot
			end

			return plot
		end
	end

	return nil
end

local function getPlotOrigin(plot: Model): CFrame
	local origin = plot:FindFirstChild(PLOT_ORIGIN_NAME)
	if origin and origin:IsA("BasePart") then
		return origin.CFrame
	end
	return plot:GetPivot()
end

local function buildProgressPayload(player: Player): TycoonProgressPayload?
	local data = DataService:GetData(player)
	if not data then
		return nil
	end
	return {
		unlocked = data.TycoonUnlocked,
		coins = data.Coins,
		stats = data.Stats,
	}
end

local function pushProgress(player: Player)
	local payload = buildProgressPayload(player)
	if not payload then
		return
	end
	RemotesService:GetTycoonProgressUpdated():FireClient(player, payload)
	DataService:PushDataToClient(player, RemotesService)
end

local function spawnStructure(player: Player, nodeId: string): Model?
	local plot = assignPlot(player)
	if not plot then
		return nil
	end

	local node = TycoonConfig.getNode(nodeId)
	if not node then
		return nil
	end

	local prefabs = getPrefabsFolder()
	if not prefabs then
		warn("[TycoonService] Missing ReplicatedStorage.TycoonPrefabs")
		return nil
	end

	local template = prefabs:FindFirstChild(node.PrefabName)
	if not template or not template:IsA("Model") then
		warn("[TycoonService] Missing prefab:", node.PrefabName)
		return nil
	end

	local structures = plot:FindFirstChild(STRUCTURES_FOLDER_NAME) :: Folder
	local clone = template:Clone()
	if not clone.PrimaryPart then
		local base = clone:FindFirstChild("Base")
		if base and base:IsA("BasePart") then
			clone.PrimaryPart = base
		end
	end
	clone.Name = node.ID
	clone:SetAttribute("TycoonNodeId", node.ID)
	clone:SetAttribute("OwnerUserId", player.UserId)
	clone:PivotTo(getPlotOrigin(plot) * node.PlotOffset)
	clone.Parent = structures

	return clone
end

local function handlePurchase(player: Player, nodeId: any): (boolean, string?)
	if typeof(nodeId) ~= "string" then
		return false, "InvalidNode"
	end

	local data = DataService:GetData(player)
	if not data then
		return false, "NoData"
	end

	local canBuy, reason = TycoonConfig.canPurchase(nodeId, data.TycoonUnlocked, data.Coins)
	if not canBuy then
		return false, reason
	end

	local node = TycoonConfig.getNode(nodeId)
	if not node then
		return false, "InvalidNode"
	end

	if not DataService:TrySpendCoins(player, node.Cost) then
		return false, "InsufficientCoins"
	end

	if not DataService:UnlockTycoonNode(player, nodeId) then
		return false, "UnlockFailed"
	end

	local plot = assignPlot(player)
	if not plot then
		return false, "NoPlot"
	end

	spawnStructure(player, nodeId)

	local spawnPayload: TycoonStructureSpawnedPayload = {
		ownerUserId = player.UserId,
		nodeId = nodeId,
		plotName = plot.Name,
	}
	RemotesService:GetTycoonStructureSpawned():FireAllClients(spawnPayload)
	pushProgress(player)

	return true, nil
end

local function restoreStructures(player: Player)
	local data = DataService:GetData(player)
	if not data then
		return
	end
	for nodeId, isUnlocked in data.TycoonUnlocked do
		if isUnlocked then
			spawnStructure(player, nodeId)
		end
	end
end

waitForTycoonRemotes()

RemotesService:GetTycoonRequestPurchase().OnServerInvoke = function(player: Player, nodeId: string)
	return handlePurchase(player, nodeId)
end

Players.PlayerAdded:Connect(function(player: Player)
	DataService:OnProfileReady(player, function()
		assignPlot(player)
		restoreStructures(player)
		pushProgress(player)
	end)
end)

for _, player in Players:GetPlayers() do
	DataService:OnProfileReady(player, function()
		assignPlot(player)
		restoreStructures(player)
		pushProgress(player)
	end)
end

Players.PlayerRemoving:Connect(function(player: Player)
	local plot = plotByPlayer[player]
	if plot then
		plotAssignments[plot.Name] = nil
		plot:SetAttribute("OwnerUserId", nil)
	end
	plotByPlayer[player] = nil
end)

print("[HybridCasualHub] TycoonService ready")
]]></string>
        </Properties>
      </Item>
    </Item>
