          <Item class="ModuleScript" referent="36">
            <Properties>
              <string name="Name">BossCombatJuice</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Shared hit VFX/SFX helpers for swarm impacts (client-only).
]]

local hitSoundIds = {
	"rbxassetid://9119720971",
	"rbxassetid://9119720970",
	"rbxassetid://9119720969",
}

local BossCombatJuice = {}

function BossCombatJuice.playHitSound(parent: Instance)
	local sound = Instance.new("Sound")
	sound.SoundId = hitSoundIds[math.random(1, #hitSoundIds)]
	sound.Volume = 0.55
	sound.PlaybackSpeed = 0.9 + math.random() * 0.25
	sound.RollOffMaxDistance = 120
	sound.Parent = parent
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

function BossCombatJuice.emitHitParticles(anchor: BasePart)
	local attachment = anchor:FindFirstChild("SwarmHitAttachment") :: Attachment?
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "SwarmHitAttachment"
		attachment.Parent = anchor
	end

	local emitter = attachment:FindFirstChild("SwarmHitBurst") :: ParticleEmitter?
	if not emitter then
		emitter = Instance.new("ParticleEmitter")
		emitter.Name = "SwarmHitBurst"
		emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		emitter.Lifetime = NumberRange.new(0.15, 0.35)
		emitter.Speed = NumberRange.new(8, 16)
		emitter.Rate = 0
		emitter.SpreadAngle = Vector2.new(35, 35)
		emitter.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.35),
			NumberSequenceKeypoint.new(1, 0),
		})
		emitter.Parent = attachment
	end

	emitter:Emit(6)
end

return BossCombatJuice
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="37">
            <Properties>
              <string name="Name">SoldierObjectPool</string>
              <string name="Source"><![CDATA[--!strict
--[[
	Client-only soldier visuals. Anchored parts — no .Touched / physics swarm.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local GameConfig = require(ReplicatedStorage.Shared.GameConfig)

export type SoldierObjectPool = {
	PrepareSwarm: (self: SoldierObjectPool, count: number, origin: CFrame) -> { BasePart },
	Release: (self: SoldierObjectPool, soldier: BasePart) -> (),
	GetActiveCount: (self: SoldierObjectPool) -> number,
}

local SoldierObjectPool = {} :: SoldierObjectPool
SoldierObjectPool.__index = SoldierObjectPool

local POOL_FOLDER_NAME = "SwarmSoldierPool"

local function createSoldier(): BasePart
	local part = Instance.new("Part")
	part.Name = "SwarmSoldier"
	part.Size = Vector3.new(0.9, 1.4, 0.9)
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.Material = Enum.Material.SmoothPlastic
	part.Color = Color3.fromRGB(72, 132, 255)
	part.CastShadow = false
	return part
end

function SoldierObjectPool.new(parent: Instance): SoldierObjectPool
	local folder = Instance.new("Folder")
	folder.Name = POOL_FOLDER_NAME
	folder.Parent = parent

	return setmetatable({
		_folder = folder,
		_available = {} :: { BasePart },
		_active = {} :: { BasePart },
	}, SoldierObjectPool)
end

function SoldierObjectPool:PrepareSwarm(count: number, origin: CFrame): { BasePart }
	local capped = math.min(count, GameConfig.SwarmVisuals.MaxAnimatedSoldiers)
	local swarm: { BasePart } = {}

	for index = 1, capped do
		local soldier = table.remove(self._available)
		if not soldier then
			soldier = createSoldier()
			soldier.Parent = self._folder
		end
		table.insert(self._active, soldier)
		table.insert(swarm, soldier)

		local ring = math.floor((index - 1) / 12)
		local angle = ((index - 1) % 12) / 12 * math.pi * 2
		local offset = Vector3.new(math.cos(angle) * (6 + ring * 2), 2 + ring * 0.2, math.sin(angle) * (6 + ring * 2))
		soldier.CFrame = origin * CFrame.new(offset)
	end

	return swarm
end

function SoldierObjectPool:Release(soldier: BasePart)
	local activeIndex = table.find(self._active, soldier)
	if activeIndex then
		table.remove(self._active, activeIndex)
	end
	soldier.Transparency = 0
	table.insert(self._available, soldier)
end

function SoldierObjectPool:GetActiveCount(): number
	return #self._active
end

return SoldierObjectPool
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="LocalScript" referent="38">
          <Properties>
            <string name="Name">TycoonController</string>
            <string name="Source"><![CDATA[--!strict
--[[
	Client tycoon pads + spawn juice. Currency and unlock state are server-authoritative.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local TycoonConfig = require(ReplicatedStorage.Shared.TycoonConfig)
local Remotes = require(ReplicatedStorage.Shared.Remotes)
local Types = require(ReplicatedStorage.Shared.Types)

type TycoonProgressPayload = Types.TycoonProgressPayload
type TycoonStructureSpawnedPayload = Types.TycoonStructureSpawnedPayload

local player = Players.LocalPlayer
local BUTTONS_FOLDER_NAME = "PurchasePads"
local PLOTS_FOLDER_NAME = "TycoonPlots"
local PLOT_ORIGIN_NAME = "Origin"

local progress: TycoonProgressPayload = {
	unlocked = {},
	coins = 0,
	stats = { StartingArmy = 0 },
}

local purchasePads: { [string]: BasePart } = {}

local remotesFolder = ReplicatedStorage:WaitForChild(Remotes.FolderName)
local requestPurchase = remotesFolder:WaitForChild(Remotes.TycoonRequestPurchase) :: RemoteFunction
local progressUpdated = remotesFolder:WaitForChild(Remotes.TycoonProgressUpdated) :: RemoteEvent
local structureSpawned = remotesFolder:WaitForChild(Remotes.TycoonStructureSpawned) :: RemoteEvent

local function getLocalPlot(): Model?
	local hub = Workspace:FindFirstChild("Hub")
	local plots = hub and hub:FindFirstChild(PLOTS_FOLDER_NAME)
	if not plots then
		return nil
	end
	for _, plot in plots:GetChildren() do
		if plot:IsA("Model") and plot:GetAttribute("OwnerUserId") == player.UserId then
			return plot
		end
	end
	return nil
end

local function getPlotOrigin(plot: Model): CFrame
	local origin = plot:FindFirstChild(PLOT_ORIGIN_NAME)
	if origin and origin:IsA("BasePart") then
		return origin.CFrame
	end
	return plot:GetPivot()
end

local function playPlacementJuice(building: Model)
	local primary = building.PrimaryPart or building:FindFirstChildWhichIsA("BasePart")
	if not primary then
		return
	end

	local baseScale = building:GetScale()
	building:ScaleTo(0.01)

	-- Model tweening via stepped ScaleTo for elastic feel
	local start = os.clock()
	local duration = 0.65
	local connection: RBXScriptConnection?
	connection = game:GetService("RunService").Heartbeat:Connect(function()
		local alpha = math.clamp((os.clock() - start) / duration, 0, 1)
		local eased = TweenService:GetValue(alpha, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out)
		local scale = math.max(0.01, eased) * baseScale
		building:ScaleTo(scale)
		if alpha >= 1 and connection then
			connection:Disconnect()
			building:ScaleTo(baseScale)
		end
	end)

	local attachment = primary:FindFirstChild("PoofAttachment") :: Attachment?
	if not attachment then
		attachment = Instance.new("Attachment")
		attachment.Name = "PoofAttachment"
		attachment.Parent = primary
	end

	local emitter = attachment:FindFirstChild("PoofEmitter") :: ParticleEmitter?
	if not emitter then
		emitter = Instance.new("ParticleEmitter")
		emitter.Name = "PoofEmitter"
		emitter.Texture = "rbxasset://textures/particles/smoke_main.dds"
		emitter.Rate = 0
		emitter.Lifetime = NumberRange.new(0.3, 0.6)
		emitter.Speed = NumberRange.new(6, 12)
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Parent = attachment
	end
	emitter:Emit(24)

	local sound = Instance.new("Sound")
	sound.SoundId = "rbxassetid://12221967"
	sound.Volume = 0.6
	sound.PlaybackSpeed = 0.95 + math.random() * 0.1
	sound.Parent = primary
	sound:Play()
	sound.Ended:Once(function()
		sound:Destroy()
	end)
end

local function findSpawnedBuilding(payload: TycoonStructureSpawnedPayload): Model?
	local hub = Workspace:FindFirstChild("Hub")
	local plots = hub and hub:FindFirstChild(PLOTS_FOLDER_NAME)
	local plot = plots and plots:FindFirstChild(payload.plotName)
	local structures = plot and plot:FindFirstChild("Structures")
	local building = structures and structures:FindFirstChild(payload.nodeId)
	if building and building:IsA("Model") then
		return building
	end
	return nil
end

local function clearPads()
	for _, pad in purchasePads do
		pad:Destroy()
	end
	table.clear(purchasePads)
end

local function createPurchasePad(plot: Model, node: TycoonConfig.TycoonNode)
	local pad = Instance.new("Part")
	pad.Name = "Pad_" .. node.ID
	pad.Size = Vector3.new(5, 1, 5)
	pad.Anchored = true
	pad.CanCollide = false
	pad.Material = Enum.Material.Neon
	pad.Color = Color3.fromRGB(255, 196, 72)
	pad.Transparency = 0.2
	pad.CFrame = getPlotOrigin(plot) * node.PlotOffset * CFrame.new(0, 0.5, 0)
	pad:SetAttribute("TycoonNodeId", node.ID)

	local billboard = Instance.new("BillboardGui")
	billboard.Size = UDim2.fromOffset(140, 56)
	billboard.StudsOffset = Vector3.new(0, 3, 0)
	billboard.AlwaysOnTop = true
	billboard.Parent = pad

	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = Color3.fromRGB(255, 255, 255)
	label.Text = string.format("%s\n%d Coins", node.ID, node.Cost)
	label.Parent = billboard

	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Unlock"
	prompt.ObjectText = node.ID
	prompt.HoldDuration = 0.25
	prompt.MaxActivationDistance = 12
	prompt.Parent = pad

	prompt.Triggered:Connect(function()
		local ok, err = requestPurchase:InvokeServer(node.ID)
		if not ok then
			warn("[Tycoon] Purchase failed:", err)
		end
	end)

	local buttonsFolder = plot:FindFirstChild(BUTTONS_FOLDER_NAME)
	if not buttonsFolder then
		buttonsFolder = Instance.new("Folder")
		buttonsFolder.Name = BUTTONS_FOLDER_NAME
		buttonsFolder.Parent = plot
	end
	pad.Parent = buttonsFolder
	purchasePads[node.ID] = pad
end

local function refreshPurchasePads()
	local plot = getLocalPlot()
	clearPads()
	if not plot then
		return
	end

	for _, node in TycoonConfig.getAllNodes() do
		if progress.unlocked[node.ID] then
			-- already built
		else
			local dependencyMet = if node.Dependency then progress.unlocked[node.Dependency] else true
			if dependencyMet then
				createPurchasePad(plot, node)
			end
		end
	end
end

progressUpdated.OnClientEvent:Connect(function(payload: TycoonProgressPayload)
	progress = payload
	refreshPurchasePads()
end)

structureSpawned.OnClientEvent:Connect(function(payload: TycoonStructureSpawnedPayload)
	local building = findSpawnedBuilding(payload)
	if building then
		playPlacementJuice(building)
	end
	if payload.ownerUserId == player.UserId then
		refreshPurchasePads()
	end
end)

task.defer(refreshPurchasePads)

print("[HybridCasualHub] TycoonController ready")
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="39">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="40">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")

export type Hud = {
	Gui: ScreenGui,
	SetCoins: (self: Hud, coins: number) -> (),
	SetTimer: (self: Hud, label: string, seconds: number) -> (),
}

local Hud = {} :: Hud
Hud.__index = Hud

function Hud.new(): Hud
	local player = Players.LocalPlayer
	local playerGui = player:WaitForChild("PlayerGui")

	local screenGui = Instance.new("ScreenGui")
	screenGui.Name = "HybridCasualHud"
	screenGui.ResetOnSpawn = false
	screenGui.IgnoreGuiInset = true
	screenGui.Parent = playerGui

	local frame = Instance.new("Frame")
	frame.Name = "Root"
	frame.AnchorPoint = Vector2.new(0.5, 0)
	frame.Position = UDim2.fromScale(0.5, 0.02)
	frame.Size = UDim2.fromOffset(320, 88)
	frame.BackgroundColor3 = Color3.fromRGB(18, 18, 24)
	frame.BackgroundTransparency = 0.15
	frame.BorderSizePixel = 0
	frame.Parent = screenGui

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = frame

	local padding = Instance.new("UIPadding")
	padding.PaddingTop = UDim.new(0, 10)
	padding.PaddingBottom = UDim.new(0, 10)
	padding.PaddingLeft = UDim.new(0, 14)
	padding.PaddingRight = UDim.new(0, 14)
	padding.Parent = frame

	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.Padding = UDim.new(0, 6)
	layout.Parent = frame

	local coinsLabel = Instance.new("TextLabel")
	coinsLabel.Name = "CoinsLabel"
	coinsLabel.Size = UDim2.new(1, 0, 0, 28)
	coinsLabel.BackgroundTransparency = 1
	coinsLabel.Font = Enum.Font.GothamBold
	coinsLabel.TextSize = 20
	coinsLabel.TextXAlignment = Enum.TextXAlignment.Left
	coinsLabel.TextColor3 = Color3.fromRGB(255, 214, 102)
	coinsLabel.Text = "Coins: 0"
	coinsLabel.Parent = frame

	local timerLabel = Instance.new("TextLabel")
	timerLabel.Name = "TimerLabel"
	timerLabel.Size = UDim2.new(1, 0, 0, 24)
	timerLabel.BackgroundTransparency = 1
	timerLabel.Font = Enum.Font.GothamMedium
	timerLabel.TextSize = 18
	timerLabel.TextXAlignment = Enum.TextXAlignment.Left
	timerLabel.TextColor3 = Color3.fromRGB(220, 220, 230)
	timerLabel.Text = "Minigame: waiting..."
	timerLabel.Parent = frame

	local self = setmetatable({
		Gui = screenGui,
		_coinsLabel = coinsLabel,
		_timerLabel = timerLabel,
	}, Hud)

	return self
end

function Hud:SetCoins(coins: number)
	self._coinsLabel.Text = string.format("Coins: %d", coins)
end

function Hud:SetTimer(label: string, seconds: number)
	if seconds > 0 then
		self._timerLabel.Text = string.format("%s — %ds", label, seconds)
	else
		self._timerLabel.Text = label
	end
end

return Hud
]]></string>
